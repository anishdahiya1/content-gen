# GEMINI API (Free tier available)
# Get key from: https://makersuite.google.com/app/apikeys
GEMINI_API_KEY="your-gemini-api-key"

# GROQ API (Free tier available)  
# Get key from: https://console.groq.com
GROQ_API_KEY="your-groq-api-key"

# SUPABASE (Database - Optional, free tier available)
# Get from: https://supabase.com
SUPABASE_URL="your-supabase-url"
SUPABASE_KEY="your-supabase-key"

# GOOGLE AUTHENTICATION CLIENT ID
# Get from Google Cloud Console (APIs & Services > Credentials)
# MUST match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID="1041586835124-e94btq3k2ojrsdtu3u20uh5jd5mimq9v.apps.googleusercontent.com"

# YOUTUBE DATA API (Optional for publishing)
YOUTUBE_API_KEY="your-youtube-api-key"

# INSTAGRAM GRAPH API (Optional for publishing)
INSTAGRAM_ACCESS_TOKEN="your-instagram-access-token"

# TIKTOK API (Optional for publishing)
TIKTOK_CLIENT_ID="your-tiktok-client-id"
TIKTOK_CLIENT_SECRET="your-tiktok-secret"

# Database (SQLite by default, can change to PostgreSQL)
DATABASE_URL="sqlite:///./creatorpilot.db"

# Environment
ENV="development"
